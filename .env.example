PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/emergency-alert
JWT_SECRET=replace_this_with_a_long_random_string
CLIENT_URL=http://localhost:5173

# Gmail address to send SOS emails FROM. Use a Gmail App Password (not your real password):
# Google Account -> Security -> 2-Step Verification -> App Passwords -> generate one for "Mail"
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16_char_app_password
